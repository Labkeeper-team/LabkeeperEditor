{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "test": "jest && playwright test",
        "test:math": "jest",
        "test:ui": "playwright test",
        "test:ui:silent": "playwright test --reporter=line",
        "build": "vite build --",
        "jest-preview": "jest-preview",
        "check": "eslint . && prettier --check --error-on-unmatched-pattern .",
        "reformat": "prettier --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint"
        ],
        "*.{css,html,json,md,scss,svg,yaml,yml}": "prettier --write"
    },
    "dependencies": {
        "@codemirror/lint": "^6.9.7",
        "@estruyf/github-actions-reporter": "^1.12.0",
        "@reduxjs/toolkit": "2.12.0",
        "@sentry/react": "^10.70.0",
        "@uiw/codemirror-extensions-events": "^4.25.11",
        "@uiw/codemirror-extensions-langs": "^4.25.11",
        "@uiw/react-codemirror": "4.25.11",
        "@yandex/smart-captcha": "^2.9.1",
        "asciimath2tex": "1.5.0",
        "axios": "1.19.0",
        "better-react-mathjax": "3.0.1",
        "classnames": "2.5.1",
        "codemirror": "6.0.2",
        "codemirror-lang-latex": "^0.6.1",
        "date-fns": "4.4.0",
        "dictionary-en": "^4.0.0",
        "dictionary-ru": "^3.0.0",
        "echarts": "6.1.0",
        "echarts-for-react": "3.0.6",
        "html2canvas": "1.4.1",
        "jspdf": "4.2.1",
        "lru_map": "^0.4.1",
        "mathjax": "3.2.2",
        "mathjax-full": "3.2.2",
        "nanoid": "^6.0.0",
        "nspell": "^2.1.5",
        "pdfjs-dist": "6.0.227",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hotkeys-hook": "^5.3.3",
        "react-markdown": "10.1.0",
        "react-redux": "9.3.0",
        "react-router-dom": "7.18.2",
        "react-to-print": "3.3.0",
        "react-toastify": "^11.1.0",
        "react-tooltip": "6.0.8",
        "redux-persist": "6.0.0",
        "rehype-raw": "^7.0.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "string-hash": "^1.1.3",
        "swiper": "14.1.0",
        "throttle-debounce": "5.0.2",
        "vite-plugin-svgr": "5.2.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/codemirror": "5.60.18",
        "@types/jest": "^30.0.0",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/redux-persist": "4.3.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "6.1.0",
        "eslint": "10.9.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "globals": "17.11.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-preview": "^0.3.3",
        "prettier": "^3.9.6",
        "lint-staged": "^17.3.0",
        "sass-embedded": "1.103.1",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.2",
        "vite-plugin-static-copy": "4.1.1"
    }
}
